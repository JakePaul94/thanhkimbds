# ── App ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# WebSocket: Customer (web) 3001 | Supervisor (Expo) 3003 (3002 = Next.js web)
WS_CUSTOMER_PORT=3001
WS_SUPERVISOR_PORT=3003
# URL public (Cloudflare tunnel, domain...) — dùng cho link ảnh/video đăng Facebook
API_BASE_URL=https://kimtruongphucserver.site

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://agent:secret@localhost:5432/morning_agent

# ── Redis (short-term memory + queue) ────────────────────────
REDIS_URL=redis://localhost:6379
MEMORY_SHORT_TTL_SEC=3600

# ── Qdrant (long-term memory) ────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agent_memory

# ── AI (Gemini) ─────────────────────────────────────────────
GEMINI_API_KEY=

# ── Google Cloud TTS (VideoLocalSkill) ───────────────────────
# API key từ Google Cloud Console: APIs & Services > Credentials > Create API Key
# Bật API: Cloud Text-to-Speech
GOOGLE_CLOUD_API_KEY=
# Tốc độ đọc: 1.0 = bình thường, 1.25 = nhanh 25%, 1.5 = nhanh 50% (0.25–4.0)
TTS_SPEAKING_RATE=1.25

# ── Video Generation ─────────────────────────────────────────
KLING_API_KEY=
KLING_API_SECRET=
RUNWAY_API_KEY=

# ── Image Generation (Gemini API) ────────────────────────────────
# Dùng GEMINI_API_KEY. Mặc định: gemini-2.5-flash-image
IMAGE_GEN_MODEL=

# ── Research ─────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Social ───────────────────────────────────────────────────
# Facebook API (đăng bài qua Graph API - dùng /me/, token xác định context)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Webhook Messenger — Verify Token khi setup webhook (GET /webhook/facebook)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=thanhkim_bds_verify

# Chrome profile (Playwright - Zalo, Facebook cũ)
FACEBOOK_CHROME_PROFILE=Default
ZALO_CHROME_PROFILE=Default

# ── Observability ────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
