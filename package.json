{
  "name": "morning-content-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "queue:ui": "bunx @bull-board/cli --port 3001",
    "expo": "cd expo-app && npm start",
    "web": "cd web && npm run dev",
    "fb:debug": "bun run scripts/fb-debug.ts",
    "trigger:test": "curl -X POST http://localhost:3000/trigger/test",
    "trigger:test:full": "curl -X POST http://localhost:3000/trigger/test/full -H 'Content-Type: application/json' -d '{\"topic\":\"Những sai lầm phổ biếnbiến khi giao dịch bất động sản\"}'",
    "qdrant:up": "docker compose up qdrant -d",
    "redis:up": "docker compose up redis -d",
    "infra:up": "docker compose up -d"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^6.5.0",
    "@google/genai": "^1.45.0",
    "@hono/node-server": "^1.12.0",
    "@hono/zod-validator": "^0.7.6",
    "@qdrant/js-client-rest": "^1.10.0",
    "axios": "^1.7.2",
    "bullmq": "^5.8.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.31.0",
    "hono": "^4.4.0",
    "ioredis": "^5.3.2",
    "langfuse": "^3.15.0",
    "node-cron": "^3.0.3",
    "pino": "^9.2.0",
    "pino-pretty": "^11.0.0",
    "playwright": "^1.45.0",
    "postgres": "^3.4.4",
    "uuid": "^10.0.0",
    "ws": "^8.17.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.11",
    "drizzle-kit": "^0.22.0",
    "typescript": "^5.4.5"
  }
}
